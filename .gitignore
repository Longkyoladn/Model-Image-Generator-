# Python cache & virtual environment
__pycache__/
*.py[cod]
*$py.class
.venv/
env/
venv/
ENV/

# Datasets & raw archives (Tuyệt đối không commit theo Mục 5)
datasets/raw/
*.tar.gz
*.zip
*.gz
*.ubyte
*.pkl
*.npy

# Model Checkpoints & Large weights (Không commit file trọng số)
outputs/checkpoints/
*.pt
*.pth
*.ckpt
*.onnx

# Reference real images for evaluation (Mục 2.6 / 3.1)
outputs/reference/
data/reference/
datasets/reference/

# Generated samples from experimental runs (ngoại trừ ảnh báo cáo nhỏ trong outputs/data_analysis/)
outputs/samples/**/images/
outputs/samples/**/*.png
outputs/samples/**/manifest.json

# Evaluation caches & temporary smoke outputs (Tuyệt đối không commit theo Mục 5)
outputs/cache/
smoke_out/
nul

# Metrics & Logs lớn
outputs/metrics/**/*.log
*.log

# Sensitive configs & secrets
.env
kaggle.json
*.token
credentials.json

# Jupyter Notebook checkpoints
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# OS specific files
